{
  "name": "delivery-optimizer",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dashboard": "npm run dev -w apps/dashboard",
    "courier": "npm run dev -w apps/courier",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w apps/dashboard && npm run typecheck -w apps/courier",
    "build": "npm run build -w apps/dashboard && npm run build -w apps/courier",
    "seed": "python scripts/build_demo_seed.py",
    "test": "npm run test -w packages/shared",
    "batches": "python scripts/generate_batches.py",
    "measure": "tsx scripts/measure.ts",
    "measure:sizes": "tsx scripts/measure.ts data/batches_sizes.json docs/baseline_by_size.md",
    "matrices": "tsx scripts/fetch_matrices.ts",
    "measure:real": "tsx scripts/measure.ts data/batches.json docs/baseline_real.md data/matrices.json"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  }
}
